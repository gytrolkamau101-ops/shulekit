VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# IntaSend — PUBLISHABLE key only (never secret key in frontend)
# Sandbox: ISPubKey_test_...
# Live:    ISPubKey_live_...
VITE_INTASEND_PUBLIC_KEY=
# false = sandbox, true = live (must match key)
VITE_INTASEND_LIVE=false
